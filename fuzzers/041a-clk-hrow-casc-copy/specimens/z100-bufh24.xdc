# xc7z100ffg900-1: pad R27 (bank 13) into the 24 BUFHCEs of CLK_HROW_TOP_R_X176Y234
set_property -dict {PACKAGE_PIN R27 IOSTANDARD LVCMOS33} [get_ports clk]
set_property -dict {PACKAGE_PIN AA13 IOSTANDARD LVCMOS33} [get_ports led]
set_property LOC BUFHCE_X0Y48 [get_cells {b[0].bufh_i}]
set_property LOC BUFHCE_X1Y48 [get_cells {b[12].bufh_i}]
set_property LOC BUFHCE_X0Y49 [get_cells {b[1].bufh_i}]
set_property LOC BUFHCE_X1Y49 [get_cells {b[13].bufh_i}]
set_property LOC BUFHCE_X0Y50 [get_cells {b[2].bufh_i}]
set_property LOC BUFHCE_X1Y50 [get_cells {b[14].bufh_i}]
set_property LOC BUFHCE_X0Y51 [get_cells {b[3].bufh_i}]
set_property LOC BUFHCE_X1Y51 [get_cells {b[15].bufh_i}]
set_property LOC BUFHCE_X0Y52 [get_cells {b[4].bufh_i}]
set_property LOC BUFHCE_X1Y52 [get_cells {b[16].bufh_i}]
set_property LOC BUFHCE_X0Y53 [get_cells {b[5].bufh_i}]
set_property LOC BUFHCE_X1Y53 [get_cells {b[17].bufh_i}]
set_property LOC BUFHCE_X0Y54 [get_cells {b[6].bufh_i}]
set_property LOC BUFHCE_X1Y54 [get_cells {b[18].bufh_i}]
set_property LOC BUFHCE_X0Y55 [get_cells {b[7].bufh_i}]
set_property LOC BUFHCE_X1Y55 [get_cells {b[19].bufh_i}]
set_property LOC BUFHCE_X0Y56 [get_cells {b[8].bufh_i}]
set_property LOC BUFHCE_X1Y56 [get_cells {b[20].bufh_i}]
set_property LOC BUFHCE_X0Y57 [get_cells {b[9].bufh_i}]
